<?xml version="1.0" encoding="utf-8"?>
<!-- Backup and device-transfer rules for Android 12+. The Gemini API key is never transferred. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="settings.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="settings.xml" />
    </device-transfer>
</data-extraction-rules>
